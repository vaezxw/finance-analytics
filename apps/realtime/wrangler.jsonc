{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-analytics-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCHLIST_ROOM",
        "class_name": "WatchlistRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WatchlistRoom"]
    }
  ]
}
